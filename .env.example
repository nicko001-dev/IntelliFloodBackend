# Copiez ce fichier en .env et adaptez-le. NE COMMITEZ JAMAIS .env.

# --- Général
ENVIRONMENT=development            # development | production
DATABASE_URL=sqlite:///./intelliflood.db
# DATABASE_URL=postgresql://intelliflood:motdepasse@localhost:5432/intelliflood
CORS_ORIGINS=*                     # en production : https://votre-appli.example
LOG_LEVEL=INFO

# --- Sécurité (F3.5)
ADMIN_API_KEY=change-me-admin-key  # protège /admin et /authorities (>= 16 caractères en production)
# SENSOR_API_KEY=                  # clé globale optionnelle pour tous les capteurs (en plus des clés par point)

# --- Logique d'alerte
RISE_WINDOW_MINUTES=5              # fenêtre de calcul de la vitesse de montée
SENSOR_OFFLINE_AFTER_SECONDS=300   # capteur « hors ligne » sans mesure depuis ce délai
ALERT_COOLDOWN_SECONDS=300         # anti-spam : pas de nouvelle alerte du même niveau dans cette fenêtre
SMS_ON_ORANGE=false                # SMS dès l'orange (sinon : push seulement)
ONPC_NOTIFY_ON_ORANGE=false

# --- IA (Module 4) : none | anthropic | openai_compatible
AI_PROVIDER=none
# AI_API_KEY=
# AI_MODEL=claude-haiku-5-5
# Local et gratuit avec Ollama :
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
AI_TIMEOUT_SECONDS=8

# --- SMS (Module 5) : console (simulation) | twilio | africastalking
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=
AT_SANDBOX=true

# --- ONPC (démonstration), séparés par des virgules
ONPC_PHONE_NUMBERS=
ONPC_EMAILS=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=alertes@intelliflood.local

# --- Notifications push (Flutter : firebase_messaging) : none | fcm
PUSH_PROVIDER=none
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase.json

# --- MQTT (optionnel)
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
